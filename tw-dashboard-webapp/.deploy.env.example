# Without your own domain, use https://tw-dashboard.YOUR_ACCOUNT_SUBDOMAIN.workers.dev
APP_ORIGIN=https://tw.example.com
ACCESS_ISSUER=https://YOUR-TEAM.cloudflareaccess.com
ACCESS_AUD=YOUR_ACCESS_APPLICATION_AUDIENCE_TAG
HYPERDRIVE_ID=YOUR_32_CHARACTER_HYPERDRIVE_ID
CLOUDFLARE_ACCOUNT_ID=YOUR_32_CHARACTER_ACCOUNT_ID
